// The APK is hydrated by r1-tools scripts/ensure-r1-apk.py from android/cromite-pin.json, not committed.
android_app_import {
    name: "Cromite",
    apk: "Cromite.apk",
    presigned: true,
    // Signed with signature v2; zipaligned and with uncompressed native libraries as shipped
    preprocessed: true,
    product_specific: true,
    dex_preopt: { enabled: false },
    // The browser in place of LineageOS's Jelly, which no build with it has
    overrides: ["Jelly"],
}
