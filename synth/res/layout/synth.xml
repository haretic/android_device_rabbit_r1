<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <!-- The name, and beside it what the wheel works on now and where it is -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView style="@style/Title" android:layout_width="wrap_content"
            android:text="@string/app_name" />
        <TextView android:id="@+id/setting" style="@style/Body"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" android:minHeight="48dp"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:gravity="end|center_vertical" android:maxLines="1" android:ellipsize="end"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="false"
            android:textColor="?android:attr/colorAccent" />
        <TextView android:id="@+id/knobs" style="@style/Body"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:minWidth="64dp" android:layout_marginEnd="12dp"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="false" android:textColor="?android:attr/colorAccent"
            android:text="@string/knobs" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <!-- The pads, and the loop under them -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="18dp"
            android:layout_marginBottom="10dp" android:orientation="vertical">
            <cat.kenny.r1.synth.PadsView android:id="@+id/pads"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" />
            <cat.kenny.r1.synth.LoopView android:id="@+id/loop"
                android:layout_width="match_parent" android:layout_height="40dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        <cat.kenny.r1.synth.KnobView android:id="@+id/knob"
            android:layout_width="84dp" android:layout_height="match_parent" />
    </LinearLayout>
    <include layout="@layout/hint" />
</LinearLayout>
