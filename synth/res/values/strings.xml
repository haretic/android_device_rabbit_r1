<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_name">Synth</string>
    <!-- The six pads, in the order of SynthEngine's -->
    <string-array name="pads">
        <item>Grain</item>
        <item>Chirp</item>
        <item>Crush</item>
        <item>Bell</item>
        <item>Sub</item>
        <item>Hat</item>
    </string-array>
    <!-- What the wheel works on, in the order of SynthActivity's: the first four are
         SynthEngine's knobs -->
    <string-array name="knobs">
        <item>Filter</item>
        <item>Pitch</item>
        <item>Stutter</item>
        <item>Echo</item>
        <item>Scale</item>
        <item>Preset</item>
        <item>Play</item>
    </string-array>
    <!-- The scales, in the order of SynthEngine's -->
    <string-array name="scales">
        <item>Major</item>
        <item>Minor</item>
        <item>Dorian</item>
        <item>Mixolydian</item>
        <item>Lydian</item>
        <item>Phrygian</item>
        <item>Harmonic minor</item>
    </string-array>
    <!-- The ready-made sounds, in the order of SynthActivity's -->
    <string-array name="presets">
        <item>Plain</item>
        <item>Warm</item>
        <item>Dark</item>
        <item>Bright</item>
        <item>Glitch</item>
        <item>Dub</item>
    </string-array>

    <!-- Beside the name: what the wheel works on now, and where it is -->
    <string name="setting_filter">Filter <xliff:g id="percent">%1$d</xliff:g>%%</string>
    <string name="setting_pitch">Pitch <xliff:g id="notes">%1$s</xliff:g></string>
    <string name="setting_stutter">Stutter <xliff:g id="rate">%1$d</xliff:g> a second</string>
    <string name="setting_echo">Echo <xliff:g id="percent">%1$d</xliff:g>%%</string>
    <string name="setting_echo_off">Echo off</string>
    <string name="setting_scale"><xliff:g id="scale">%1$s</xliff:g> scale</string>
    <string name="setting_preset">Preset <xliff:g id="preset">%1$s</xliff:g></string>
    <string name="setting_custom">Your own setup</string>
    <string name="setting_play">Play <xliff:g id="pad">%1$s</xliff:g></string>

    <!-- What the wheel and the button do, along the bottom, one for each of "knobs" -->
    <string name="hint_filter">The wheel opens and closes the filter. Press for pitch.</string>
    <string name="hint_pitch">The wheel moves the pads a note at a time. Press for stutter.</string>
    <string name="hint_stutter">A held pad repeats, the wheel sets how fast. Press for echo.</string>
    <string name="hint_echo">The wheel sets the echo, all the way down is off. Press for scale.</string>
    <string name="hint_scale">The wheel picks the scale the pads play in. Press for presets.</string>
    <string name="hint_preset">The wheel picks a ready-made sound. Press to play and loop by wheel.</string>
    <string name="knobs">Knobs</string>
    <string name="hint_play">Wheel picks a pad or the loop. Press to play, hold to repeat. Turn past either end or tap Knobs to leave.</string>
    <string name="hint_play_held">Repeating. Wheel sets how fast. Let go, then turn past either end for knobs.</string>
    <string name="hint_play_top_held">Repeating. Turn up for knobs. Let go to stop.</string>
    <!-- The loop, under the pads: its states, in the order of SynthEngine's LOOP_ -->
    <string-array name="loop_states">
        <item>Loop</item>
        <item>Ready</item>
        <item>Recording</item>
        <item>Looping</item>
        <item>Adding</item>
        <item>Stopped</item>
    </string-array>
    <!-- Its one button in each state: record, cancel the wait, close the take and hear it,
         add on top, stop adding, play again -->
    <string-array name="loop_actions">
        <item>Record</item>
        <item>Cancel</item>
        <item>Play</item>
        <item>Add</item>
        <item>Done</item>
        <item>Play</item>
    </string-array>
    <!-- Beside the name, with the wheel on the loop's button in Play -->
    <string-array name="loop_settings">
        <item>Record a loop</item>
        <item>Cancel recording</item>
        <item>Close the loop</item>
        <item>Add to the loop</item>
        <item>Done adding</item>
        <item>Play the loop</item>
    </string-array>
    <string name="loop_clear">Clear</string>
    <string name="setting_loop_clear">Clear the loop</string>
    <string name="loop_ready_detail">play a pad</string>
    <string name="loop_seconds"><xliff:g id="seconds">%1$s</xliff:g> s</string>
    <string name="loop_description"><xliff:g id="state">%1$s</xliff:g>, <xliff:g id="action">%2$s</xliff:g></string>
    <!-- With the wheel on the loop's button in Play, one for each state, and on Clear -->
    <string-array name="loop_hints">
        <item>Press to record a loop, it starts with the first pad. Turn down for knobs.</item>
        <item>Ready. Turn up to a pad and press it to start. Press here to cancel.</item>
        <item>Recording. Press to close the loop and hear it. Turn down for Clear.</item>
        <item>Looping. Press to play more on top. Turn down for Clear.</item>
        <item>Adding. Pads you play now join the loop. Press when done, turn down for Clear.</item>
        <item>Loop stopped. Press to play it again. Turn down for Clear.</item>
    </string-array>
    <string name="hint_loop_clear">Press to clear the loop. Turn up to keep it, down for knobs.</string>
</resources>
