<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <TextView style="@style/Title" android:text="@string/sound" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:baselineAligned="true">
        <TextView android:id="@+id/level" style="@style/Number"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="84sp" />
        <TextView style="@style/Number" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="12dp"
            android:text="@string/sound_unit" android:textSize="18sp" />
    </LinearLayout>
    <TextView android:id="@+id/words" style="@style/Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    <cat.kenny.r1.toolbox.BarsView android:id="@+id/bars"
        android:layout_width="match_parent" android:layout_height="120dp"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp">
        <TextView style="@style/Dim" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/sound_ago"
            android:textSize="12sp" />
        <TextView style="@style/Dim" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/sound_now"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/loudest" style="@style/Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="14dp" />
    <TextView android:id="@+id/average" style="@style/Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp" android:layout_marginBottom="14dp" />
    <include layout="@layout/hint" />
</LinearLayout>
