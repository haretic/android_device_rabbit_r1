<!-- A row of the list: the one the wheel is on is outlined in the accent -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#2A1A12" /><corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="?android:attr/colorAccent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#262626" /><corners android:radius="16dp" /></shape>
    </item>
    <item><shape><solid android:color="@color/surface" /><corners android:radius="16dp" /></shape></item>
</selector>
