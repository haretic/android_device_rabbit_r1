<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <TextView style="@style/Title" android:text="@string/level" android:paddingBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical">
        <cat.kenny.r1.toolbox.BubbleView android:id="@+id/bubble"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="20dp"
            android:layout_marginBottom="8dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView android:id="@+id/angle" style="@style/Number"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="40sp" />
            <TextView android:id="@+id/detail" style="@style/Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:layout_marginEnd="8dp" />
        </LinearLayout>
        <include layout="@layout/level_modes" />
    </LinearLayout>
    <include layout="@layout/hint" />
</LinearLayout>
