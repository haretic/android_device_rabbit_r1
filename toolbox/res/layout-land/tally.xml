<!-- Lying down the count and its laps sit side by side: stacked they cut the last lap off -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">
    <TextView style="@style/Title" android:text="@string/tally" android:paddingBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="24dp" android:gravity="center_vertical">
            <TextView android:id="@+id/count" style="@style/Number"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:gravity="bottom|start"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="36sp"
                android:autoSizeMaxTextSize="96sp" />
            <TextView android:id="@+id/since" style="@style/Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/laps" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="0.8"
            android:layout_marginStart="16dp" android:orientation="vertical" />
        <!-- Which way the wheel counts, beside the wheel -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="14dp" android:layout_marginStart="8dp"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/tally_less" style="@style/Body"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="48dp" android:minHeight="48dp" android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:text="−"
                android:textColor="@color/text_faint" android:textSize="22sp"
                android:importantForAccessibility="yes" />
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
                android:rotation="90" android:src="@drawable/hint_button"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/tally_more" style="@style/Body"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="48dp" android:minHeight="48dp" android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:text="+"
                android:textColor="?android:attr/colorAccent" android:textSize="22sp"
                android:importantForAccessibility="yes" />
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/hint" />
</LinearLayout>
