// SPDX-License-Identifier: Apache-2.0
soong_namespace {}

cc_defaults {
    name: "r1_charging_defaults",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: ["libbase", "liblog"],
    system_ext_specific: true,
}

cc_binary {
    name: "r1-charging",
    defaults: ["r1_charging_defaults"],
    srcs: ["native/service.cpp"],
    init_rc: ["r1-charging.rc"],
}
