# SPDX-License-Identifier: Apache-2.0
# Settings > Battery > Battery details (batterydetails/, system_app) saves the choice;
# only this daemon writes the policy cap.
type r1_charging, domain, coredomain;
type r1_charging_exec, exec_type, system_file_type, file_type;
init_daemon_domain(r1_charging)

type sysfs_r1_charging, fs_type, sysfs_type;
system_internal_prop(r1_charging_prop)

get_prop(r1_charging, r1_charging_prop)
allow r1_charging sysfs_r1_charging:dir search;
allow r1_charging sysfs_r1_charging:file rw_file_perms;
allow r1_charging sysfs:dir search;
