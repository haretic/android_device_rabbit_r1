<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Settings > System > Problem report -->
    <string name="report_title">Problem report</string>
    <string name="report_summary">Save logs for a bug report</string>

    <string name="intro">Saves the system logs from now and from the last start, crash reports and a description of this r1 as one .zip in Download/haretic-reports. Takes about a minute.</string>

    <string name="note_title">What went wrong?</string>
    <string name="note_hint">Optional, goes into the report</string>
    <string name="note_dialog">What were you doing, and what happened?</string>

    <string name="save_title">Save report</string>
    <string name="save_summary">Saved in Download/haretic-reports</string>
    <!-- e.g. "Saving the kernel log (step 3 of 8)…" -->
    <string name="save_running">Saving <xliff:g id="what">%1$s</xliff:g> (step <xliff:g id="step">%2$d</xliff:g> of <xliff:g id="steps">%3$d</xliff:g>)…</string>
    <string name="save_done">Saved: <xliff:g id="file">%1$s</xliff:g></string>
    <string name="save_done_toast">Report saved in <xliff:g id="file">%1$s</xliff:g></string>
    <string name="save_failed">Not saved. <xliff:g id="why">%1$s</xliff:g></string>
    <string name="error_busy">Another report is being saved.</string>
    <string name="error_start">The log collector didn\'t start.</string>
    <string name="error_stopped">The report stopped before it was done.</string>
    <string name="error_cant_write">The file could not be written. Is the storage full?</string>

    <string name="step_system">the description of this r1</string>
    <string name="step_logcat">the Android log</string>
    <string name="step_kernel">the kernel log</string>
    <string name="step_crashes">crash reports</string>
    <string name="step_power">battery and power</string>
    <string name="step_devices">devices and the screen</string>
    <string name="step_apps">the list of apps</string>
    <string name="step_saving">the file</string>

    <string name="last_start_title">Logs from the last start</string>
    <string name="last_start_panic">The last start ended with a kernel panic. Its log is kept and goes into the report.</string>
    <string name="last_start_panic_lost">The last start ended with a kernel panic, but its log wasn\'t kept.</string>
    <string name="last_start_reset">The last start ended with a watchdog reset. Its log is kept and goes into the report.</string>
    <string name="last_start_reset_lost">The last start ended with a watchdog reset, but its log wasn\'t kept.</string>
    <string name="last_start_kept">Kept, they go into the report.</string>
    <string name="last_start_none">None. They are only kept when the r1 restarts, not when it was switched off or the battery ran empty.</string>
    <string name="last_start_unknown">Not looked at yet, the r1 is still starting.</string>

    <string name="privacy">The report lists your apps. Wi-Fi network names, accounts, phone numbers, IMEI and serial numbers are taken out, but the logs can still name Bluetooth devices nearby. Have a look before you post it in public.</string>

    <!-- Developer options > Self test -->
    <string name="self_test_title">Self test</string>
    <string name="self_test_intro">This r1 runs its own UI checks and takes over the screen while it works. Your settings are put back afterwards.</string>
    <string name="self_test_quick">Quick check</string>
    <string name="self_test_quick_summary">About 5 minutes - the wheel, dialogs, taskbar, rotation</string>
    <string name="self_test_full">Full test</string>
    <string name="self_test_full_summary">About 40 minutes - every check the build runs</string>
    <string name="self_test_confirm">The self test will take over the screen. To stop it, go back to Self test and choose Stop. Your settings will be put back when it ends.</string>
    <string name="self_test_start">Start</string>
    <string name="self_test_starting">Starting...</string>
    <string name="self_test_didnt_start">The self test didn\'t start</string>
    <string name="self_test_start_error">The self test could not be started.</string>
    <string name="self_test_progress">Test <xliff:g id="index">%1$d</xliff:g> of <xliff:g id="total">%2$d</xliff:g> - <xliff:g id="test">%3$s</xliff:g></string>
    <string name="self_test_counts"><xliff:g id="passed">%1$d</xliff:g> passed, <xliff:g id="failed">%2$d</xliff:g> failed</string>
    <string name="self_test_stop">Stop</string>
    <string name="self_test_stopping">Stopping after this check - putting your settings back</string>
    <string name="self_test_stop_error">The self test could not be stopped. Try Stop again.</string>
    <string name="self_test_results"><xliff:g id="passed">%1$d</xliff:g> passed, <xliff:g id="failed">%2$d</xliff:g> failed, <xliff:g id="skipped">%3$d</xliff:g> skipped</string>
    <string name="self_test_stopped">Stopped - <xliff:g id="counts">%1$s</xliff:g></string>
    <string name="self_test_error">Self test error - <xliff:g id="reason">%1$s</xliff:g></string>
    <string name="self_test_test_verdict"><xliff:g id="test">%1$s</xliff:g> - <xliff:g id="verdict">%2$s</xliff:g></string>
    <string name="self_test_passed">passed</string>
    <string name="self_test_passed_retry">passed on retry</string>
    <string name="self_test_failed">failed</string>
    <string name="self_test_skipped">skipped</string>
    <string name="self_test_skipped_group">Skipped - <xliff:g id="count">%1$d</xliff:g></string>
    <string name="self_test_passed_group">Passed - <xliff:g id="count">%1$d</xliff:g></string>
    <string name="self_test_loading_shot">Loading screenshot...</string>
    <string name="self_test_missing_shot">Screenshot unavailable</string>
    <string name="self_test_close">Close</string>
    <string name="self_test_add_report">Add to problem report</string>
    <string name="self_test_again">Run again</string>
    <string name="self_test_attachment">Self test results</string>
    <string name="self_test_attachment_summary">The log, status and failed checks\' screenshots go into this report. Screenshots are kept as they are.</string>
</resources>
