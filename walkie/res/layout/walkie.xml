<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/listening" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:fitsSystemWindows="true">
        <!-- The name, and the settings for a finger: the wheel reaches them past the channels -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView style="@style/Title" android:layout_width="0dp"
                android:layout_weight="1" android:text="@string/app_name" />
            <ImageButton android:id="@+id/messages_button" android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_messages" android:scaleType="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:focusable="false" android:contentDescription="@string/messages" />
            <ImageButton android:id="@+id/settings_button" android:layout_width="48dp"
                android:layout_height="48dp" android:layout_marginEnd="12dp"
                android:src="@drawable/ic_settings" android:scaleType="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:focusable="false" android:contentDescription="@string/settings" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="24dp">
                <TextView android:id="@+id/channel" style="@style/Number"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="25sp" />
                <!-- Leaves the finger to the page until the list needs scrolling -->
                <cat.kenny.r1.walkie.PeopleScroll android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp">
                    <LinearLayout android:id="@+id/people" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                </cat.kenny.r1.walkie.PeopleScroll>
                <TextView android:id="@+id/nobody" style="@style/Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/text_dim" />
                <!-- Who is talking, large, for as long as they talk -->
                <TextView android:id="@+id/speaker" style="@style/Number"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textSize="28sp"
                    android:textColor="?android:attr/colorAccent" android:ellipsize="end"
                    android:accessibilityLiveRegion="polite" android:visibility="gone" />
                <cat.kenny.r1.walkie.WaveView android:id="@+id/wave"
                    android:layout_width="match_parent" android:layout_height="76dp"
                    android:layout_marginTop="18dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/again" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:minHeight="48dp" android:focusable="false"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical" android:visibility="gone">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:padding="9dp" android:background="@drawable/icon_bg"
                        android:src="@drawable/ic_replay"
                        android:tint="?android:attr/colorAccent"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/again_text" style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFamily="haretic-text-medium" />
                </LinearLayout>
            </LinearLayout>
            <cat.kenny.r1.walkie.DrumView android:id="@+id/drum"
                android:layout_width="150dp" android:layout_height="match_parent" />
        </LinearLayout>
        <include layout="@layout/hint" />
    </LinearLayout>
    <cat.kenny.r1.walkie.TalkView android:id="@+id/talking"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
