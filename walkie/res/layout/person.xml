<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="14dp" android:gravity="center_vertical">
    <TextView android:id="@+id/initial" android:layout_width="40dp"
        android:layout_height="40dp" android:gravity="center"
        android:background="@drawable/icon_bg" android:textColor="@color/text"
        android:textSize="16sp" android:fontFamily="haretic-text-bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="14dp"
        android:orientation="vertical">
        <TextView android:id="@+id/name" style="@style/Body"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="haretic-text-medium" android:textSize="17sp"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/state" style="@style/Dim"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
