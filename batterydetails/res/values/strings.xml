<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Settings > Battery -->
    <string name="details_title">Battery Details</string>
    <string name="details_summary">Level over 24 hours, voltage, current and charging</string>

    <!-- The top of the page -->
    <string name="percent"><xliff:g id="percent">%1$d</xliff:g>%%</string>
    <string name="status_charging">Charging</string>
    <string name="status_full">Full</string>
    <string name="status_on_battery">On battery</string>
    <string name="status_not_charging">Plugged in, not charging</string>
    <string name="status_limit_hold">Plugged in, held at the charge limit</string>
    <!-- e.g. "full in about 40 min" -->
    <string name="time_to_full">full in about <xliff:g id="time">%1$s</xliff:g></string>
    <!-- e.g. "about 5 hr, 10 min left" -->
    <string name="time_left">about <xliff:g id="time">%1$s</xliff:g> left</string>
    <!-- Joins the status and the time, e.g. "Charging - full in about 40 min" -->
    <string name="status_and_time"><xliff:g id="status">%1$s</xliff:g> - <xliff:g id="time">%2$s</xliff:g></string>
    <string name="graph_ago">24 h ago</string>
    <string name="graph_now">now</string>
    <string name="graph_empty">The graph fills in as you use the r1: the level is noted about every 15 minutes while it is awake.</string>

    <!-- Right now -->
    <string name="now_title">Right now</string>
    <string name="voltage_current">Voltage - Current</string>
    <string name="power_temperature">Power - Temperature</string>
    <string name="charger">Charger</string>
    <!-- Two readings in one row, e.g. "4.12 V - +1.08 A" -->
    <string name="value_pair"><xliff:g id="first">%1$s</xliff:g> - <xliff:g id="second">%2$s</xliff:g></string>
    <string name="value_volts"><xliff:g id="volts">%1$.2f</xliff:g> V</string>
    <!-- Plus while charging, minus on battery -->
    <string name="value_amps"><xliff:g id="amps">%1$+.2f</xliff:g> A</string>
    <string name="value_watts"><xliff:g id="watts">%1$+.1f</xliff:g> W</string>
    <string name="value_celsius"><xliff:g id="celsius">%1$.0f</xliff:g> °C</string>
    <!-- A reading the r1 doesn't have right now -->
    <string name="value_unknown">–</string>
    <string name="charger_none">Not plugged in</string>
    <!-- A charger or a charging port that says so (1 A) -->
    <string name="charger_fast">USB charger</string>
    <!-- A computer's USB port or a charger that doesn't say what it is (0.5 A) -->
    <string name="charger_port">USB port</string>
    <string name="charger_usb">USB</string>
    <!-- e.g. "USB charger, 5.1 V", the voltage the r1 measures on the cable -->
    <string name="charger_volts"><xliff:g id="charger">%1$s</xliff:g>, <xliff:g id="volts">%2$.1f</xliff:g> V</string>

    <!-- Battery care -->
    <string name="care_title">Battery care</string>
    <string name="current_title">Charge current</string>
    <string name="current_default"><xliff:g id="amps">%1$s</xliff:g> A - the default, what the stock battery is rated for</string>
    <string name="current_fast"><xliff:g id="amps">%1$s</xliff:g> A - faster than the stock battery is rated for</string>
    <string name="current_unsafe"><xliff:g id="amps">%1$s</xliff:g> A - UNSAFE, for a larger battery and a PMIC heat sink only</string>
    <string name="current_slower"><xliff:g id="amps">%1$s</xliff:g> A - gentler, slower</string>
    <string name="current_slowest"><xliff:g id="amps">%1$s</xliff:g> A - gentlest, slowest</string>
    <!-- Second line while plugged in, when the charger gets less than the choice -->
    <string name="current_now_usb">Now <xliff:g id="amps">%1$s</xliff:g> A: the USB port gives no more</string>
    <string name="current_now_thermal">Now <xliff:g id="amps">%1$s</xliff:g> A: gentler while the battery is cold or warm</string>
    <!-- The picker, e.g. "0.8 A, about 3.1 W" into the battery -->
    <string name="current_choice"><xliff:g id="amps">%1$s</xliff:g> A, about <xliff:g id="watts">%2$s</xliff:g> W</string>
    <string name="current_choice_default"><xliff:g id="amps">%1$s</xliff:g> A, about <xliff:g id="watts">%2$s</xliff:g> W (default)</string>
    <string name="current_save_failed">Couldn\'t change the charge current</string>
    <!-- Picker labels above the stock 1 A -->
    <string name="current_choice_fast"><xliff:g id="amps">%1$s</xliff:g> A, about <xliff:g id="watts">%2$s</xliff:g> W (faster than stock)</string>
    <string name="current_choice_unsafe"><xliff:g id="amps">%1$s</xliff:g> A, about <xliff:g id="watts">%2$s</xliff:g> W (UNSAFE)</string>
    <!-- Show unsafe values -->
    <string name="unsafe_show_title">Show unsafe values</string>
    <string name="unsafe_show_summary">Lists charge currents above 2 A, for an r1 with a larger battery fitted by hand. Never for the stock battery.</string>
    <string name="unsafe_hidden">Unsafe values hidden, the charge current is back to 1 A</string>
    <!-- The confirmation above the stock 1 A -->
    <string name="fast_confirm_title">Faster than stock charging</string>
    <string name="fast_confirm_message">The r1\'s battery is rated for 1 A. At <xliff:g id="amps">%1$s</xliff:g> A it and the charging chip run hotter, and the battery wears out sooner and holds less charge over time.\n\nThe r1 drops back to 1 A from 38 °C battery temperature, but that does not make this as safe as the default. If the battery swells or the r1 gets hot to the touch, unplug it and go back to 1 A.</string>
    <string name="fast_confirm_check">I understand the risk to my battery</string>
    <string name="unsafe_confirm_title">UNSAFE charge current</string>
    <string name="unsafe_confirm_message">Do NOT use this with the stock battery. <xliff:g id="amps">%1$s</xliff:g> A is far more than the stock 1000 mAh battery can take: it can overheat, swell, catch fire or explode.\n\nThis is only for an r1 with a larger replacement battery that is rated for this current, AND a heat sink fitted to the PMIC. Without a heat sink the PMIC can overheat and be damaged at this current, and the battery\'s temperature sensor cannot see it.\n\nThe r1 still drops back to 1 A from 42 °C battery temperature. Any damage to the r1, the battery or anything around it is your own responsibility.</string>
    <string name="unsafe_confirm_check">I understand. My r1 has a larger battery rated for this current and a PMIC heat sink.</string>
    <string name="confirm_use">Use <xliff:g id="amps">%1$s</xliff:g> A</string>
    <string name="limit_title">Charge limit</string>
    <string name="limit_stops_at">Stops at <xliff:g id="percent">%1$d</xliff:g> %%</string>
    <string name="limit_off" formatted="false">Off, charges to 100 %</string>
    <string name="limit_scheduled">On, finishes charging on a schedule</string>

    <!-- What drained me: where the charge went, by screen on, awake with the screen off, asleep -->
    <string name="drain_title">What drained me</string>
    <string name="drain_summary">Where the charge went: the screen, awake and asleep</string>
    <string name="drain_loading">Reading the battery history…</string>
    <string name="drain_unavailable">The battery history can\'t be read right now.</string>
    <string name="drain_period_charge">Since charge</string>
    <string name="drain_period_day">24 hours</string>
    <string name="drain_period_week">7 days</string>
    <!-- The big line, e.g. "100 % → 58 %" for a run off the charger, "37 % used" for a period -->
    <string name="drain_levels"><xliff:g id="from">%1$d</xliff:g> %% → <xliff:g id="to">%2$d</xliff:g> %%</string>
    <string name="drain_used"><xliff:g id="percent">%1$d</xliff:g> %% used</string>
    <!-- Under it, e.g. "in 9 h 25 min, since the charger came off at 22:40" -->
    <string name="drain_since">in <xliff:g id="time">%1$s</xliff:g>, since the charger came off at <xliff:g id="clock">%2$s</xliff:g></string>
    <string name="drain_until">in <xliff:g id="time">%1$s</xliff:g>, from <xliff:g id="clock">%2$s</xliff:g> until the charger at <xliff:g id="end">%3$s</xliff:g></string>
    <string name="drain_off_charger_day"><xliff:g id="time">%1$s</xliff:g> off the charger in the last 24 hours</string>
    <string name="drain_off_charger_week"><xliff:g id="time">%1$s</xliff:g> off the charger in the last 7 days</string>
    <string name="drain_bar_now">now</string>
    <!-- No time off the charger in the period -->
    <string name="drain_none">On the charger the whole time: nothing to tell.</string>
    <string name="drain_none_yet">No time off the charger in the history yet.</string>
    <!-- The sentence. One of the first four, then perhaps one of the "but" sentences -->
    <string name="drain_story_little">Hardly anything so far.</string>
    <string name="drain_story_screen">Mostly the screen.</string>
    <string name="drain_story_awake">Mostly awake with the screen off, when it should have been asleep.</string>
    <string name="drain_story_asleep">Mostly while asleep.</string>
    <string name="drain_story_mixed">Spread over the screen, awake and asleep.</string>
    <!-- e.g. "But Aurora Store also kept the r1 awake for 31 min while the screen was off." -->
    <string name="drain_story_app">But <xliff:g id="app">%1$s</xliff:g> also kept the r1 awake for <xliff:g id="time">%2$s</xliff:g> while the screen was off.</string>
    <string name="drain_story_wakeups">But it also woke up <xliff:g id="count">%1$d</xliff:g> times with the screen off, <xliff:g id="time">%2$s</xliff:g> in all.</string>
    <string name="drain_story_sleep_fast">Asleep it lost more than this r1 usually does.</string>
    <!-- The three rows -->
    <string name="drain_screen">Screen on</string>
    <string name="drain_awake">Awake, screen off</string>
    <string name="drain_asleep">Asleep</string>
    <string name="drain_row_percent"><xliff:g id="percent">%1$d</xliff:g> %%</string>
    <!-- e.g. "1 h 12 min - mostly Cromite" -->
    <string name="drain_row_mostly"><xliff:g id="time">%1$s</xliff:g> - mostly <xliff:g id="app">%2$s</xliff:g></string>
    <string name="drain_row_awake_much"><xliff:g id="time">%1$s</xliff:g> - a lot for a screen that was off</string>
    <!-- e.g. "7 h 21 min - 1.2 % an hour, normal" -->
    <string name="drain_row_rate"><xliff:g id="time">%1$s</xliff:g> - <xliff:g id="rate">%2$s</xliff:g> %% an hour</string>
    <string name="drain_row_rate_normal"><xliff:g id="time">%1$s</xliff:g> - <xliff:g id="rate">%2$s</xliff:g> %% an hour, normal</string>
    <string name="drain_row_rate_high"><xliff:g id="time">%1$s</xliff:g> - <xliff:g id="rate">%2$s</xliff:g> %% an hour, more than usual</string>
    <!-- The reading sinks for some minutes after the cable is pulled -->
    <string name="drain_settling"><xliff:g id="percent">%1$d</xliff:g> %% more went while the reading settled after the charger came off. That is the gauge, not use.</string>
    <string name="drain_hint">Press a row to see who was running.</string>
    <!-- The page of one state. e.g. "9 %" and "in 52 min" -->
    <string name="drain_state_time">in <xliff:g id="time">%1$s</xliff:g></string>
    <string name="drain_screen_story">What was in front while the screen was on:</string>
    <string name="drain_awake_story">With the screen off the r1 should be asleep. These kept it awake:</string>
    <string name="drain_asleep_story">Asleep the r1 lost <xliff:g id="rate">%1$s</xliff:g> %% an hour.</string>
    <string name="drain_asleep_story_usual">Asleep the r1 lost <xliff:g id="rate">%1$s</xliff:g> %% an hour. Its usual is <xliff:g id="usual">%2$s</xliff:g> %%.</string>
    <string name="drain_state_none">No time in this state.</string>
    <!-- A row there, e.g. "31 min - about 5 %" -->
    <string name="drain_who_share"><xliff:g id="time">%1$s</xliff:g> - about <xliff:g id="percent">%2$d</xliff:g> %%</string>
    <string name="drain_who_share_small"><xliff:g id="time">%1$s</xliff:g> - under 1 %%</string>
    <string name="drain_who_home">Home screen</string>
    <string name="drain_who_front">Lock screen and system</string>
    <string name="drain_who_wakeups">Brief wake-ups</string>
    <plurals name="drain_who_wakeups_summary">
        <item quantity="one">Woke once and went back to sleep</item>
        <item quantity="other">Woke <xliff:g id="count">%1$d</xliff:g> times and went back to sleep</item>
    </plurals>
    <string name="drain_who_system">System</string>
    <string name="drain_who_radio">Mobile radio</string>
    <string name="drain_who_bluetooth">Bluetooth</string>
    <string name="drain_who_audio">Sound</string>
    <string name="drain_who_other">Other</string>
    <!-- What it was doing, from the name of what held the r1 awake -->
    <string name="drain_why_job">Ran a background task</string>
    <string name="drain_why_alarm">An alarm it had set went off</string>
    <string name="drain_why_radio">Talked to the mobile network</string>
    <string name="drain_why_audio">Played sound</string>
    <string name="drain_why_vibrator">Vibrated</string>
    <string name="drain_why_location">Looked up the location</string>
    <string name="drain_why_sync">Synced an account</string>
    <string name="drain_why_wifi">Used Wi-Fi</string>
    <string name="drain_why_network">Kept a network connection going</string>
    <string name="drain_why_download">Downloaded</string>
    <string name="drain_why_power_key">The side button was pressed</string>
    <!-- At the end of an app's row; a press switches -->
    <string name="drain_restrict">Restrict</string>
    <string name="drain_restricted">Restricted</string>
    <string name="drain_restrict_hint">Press an app to restrict it: it then stops running while you are not using it. Press again to allow it.</string>
    <string name="drain_about_hint">The time is measured. An app\'s share of the percent goes by its time, so it is a rough figure.</string>
    <!-- The asleep page -->
    <string name="drain_woke">Woke up</string>
    <plurals name="drain_woke_count">
        <item quantity="one">Once</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> times</item>
    </plurals>
    <string name="drain_woke_every">about every <xliff:g id="time">%1$s</xliff:g></string>
    <string name="drain_longest_sleep">Longest sleep in one piece</string>
    <!-- Lengths of time -->
    <string name="drain_minutes"><xliff:g id="minutes">%1$d</xliff:g> min</string>
    <string name="drain_hours_minutes"><xliff:g id="hours">%1$d</xliff:g> h <xliff:g id="minutes">%2$d</xliff:g> min</string>
    <string name="drain_hours"><xliff:g id="hours">%1$d</xliff:g> h</string>
