<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/details_title">
    <com.android.settingslib.widget.UntitledPreferenceCategory android:key="top">
        <cat.kenny.r1.batterydetails.HeaderPreference android:key="header" />
        <Preference
            android:key="drain"
            android:title="@string/drain_title"
            android:summary="@string/drain_summary"
            android:persistent="false" />
    </com.android.settingslib.widget.UntitledPreferenceCategory>
    <PreferenceCategory
        android:key="now"
        android:title="@string/now_title">
        <cat.kenny.r1.batterydetails.ValuePreference
            android:key="voltage_current"
            android:title="@string/voltage_current" />
        <cat.kenny.r1.batterydetails.ValuePreference
            android:key="power_temperature"
            android:title="@string/power_temperature" />
        <cat.kenny.r1.batterydetails.ValuePreference
            android:key="charger"
            android:title="@string/charger" />
    </PreferenceCategory>
    <PreferenceCategory
        android:key="care"
        android:title="@string/care_title">
        <!-- Removed when the kernel has no charging policy -->
        <Preference
            android:key="charge_current"
            android:title="@string/current_title"
            android:persistent="false" />
        <!-- Lists the charge currents above 2 A, for larger cells fitted by hand -->
        <SwitchPreferenceCompat
            android:key="show_unsafe_current"
            android:title="@string/unsafe_show_title"
            android:summary="@string/unsafe_show_summary"
            android:defaultValue="false" />
        <!-- Lineage's Charging control; removed when the health HAL has none -->
        <Preference
            android:key="charge_limit"
            android:title="@string/limit_title"
            android:persistent="false" />
    </PreferenceCategory>
    <!-- How this page shows things: a press or a tap moves a row on to its next choice, the
         first choice of each is how the page always was. In the app's own preferences. -->
    <PreferenceCategory
        android:key="page"
        android:title="@string/page_title">
        <Preference
            android:key="page_hint"
            android:summary="@string/page_hint"
            android:selectable="false" />
        <cat.kenny.r1.batterydetails.CyclePreference
            android:key="page_refresh"
            android:defaultValue="2"
            android:entries="@array/page_refresh_entries"
            android:entryValues="@array/page_refresh_values"
            android:summary="%s"
            android:title="@string/page_refresh" />
        <cat.kenny.r1.batterydetails.CyclePreference
            android:key="page_temperature"
            android:defaultValue="c"
            android:entries="@array/page_temperature_entries"
            android:entryValues="@array/page_temperature_values"
            android:summary="%s"
            android:title="@string/page_temperature" />
        <cat.kenny.r1.batterydetails.CyclePreference
            android:key="page_current"
            android:defaultValue="a"
            android:entries="@array/page_current_entries"
            android:entryValues="@array/page_current_values"
            android:summary="%s"
            android:title="@string/page_current" />
        <cat.kenny.r1.batterydetails.CyclePreference
            android:key="page_graph"
            android:defaultValue="shown"
            android:entries="@array/page_graph_entries"
            android:entryValues="@array/page_graph_values"
            android:summary="%s"
            android:title="@string/page_graph" />
    </PreferenceCategory>
</PreferenceScreen>
