<resources>
    <!-- Default device name, otherwise just the model. Only used when the
         setting is first created. -->
    <string name="def_device_name_simple" translatable="false">haretic rabbit r1</string>
    <!-- Window and transition animations at half length: the r1's small screen makes the
         full-length ones feel slow. App animations keep their speed. -->
    <fraction name="def_window_animation_scale">50%</fraction>
    <fraction name="def_window_transition_scale">50%</fraction>
    <!-- Notifications stay whole on the lock screen once seen: folded into an icon, they were
         an unlabelled dot on the r1's small screen -->
    <integer name="def_lock_screen_notification_minimalism">0</integer>
</resources>
