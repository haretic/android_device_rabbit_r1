<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2% above the lowest level the panel still shows (ro.vendor.drmfb.backlight_min),
         the lowest the user found comfortable. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.02</item>

    <!-- The r1 has no Back or Home keys (only the side button and the scroll wheel).
         Without a navigation bar SystemUI also never attaches the back gesture. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- The panel offers 60 to 100 Hz (panel-rabbit-r1). A non-zero default rate caps
         rendering below the user's peak (60 made 85 Hz render at 42.5 Hz); 0 lets the
         peak rate act as the default. 100 Hz is the panel's preferred mode, so boot
         needs no mode switch. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">100</integer>
    <!-- The motor runs from VIBR, whose steps between the vibrator's 2.0 and
         3.0 V limits are 2.0, 2.8 and 3.0 V; amplitude maps linearly onto that
         range and regulator-haptic picks the nearest step. These factors put
         low, medium (the default) and high on one step each. -->
    <string-array name="config_vibrationIntensityScaleFactors" translatable="false">
        <item>0.2</item>
        <item>0.75</item>
        <item>1.0</item>
    </string-array>
    <!-- The mainline kernel has no android_usb class; UsbDeviceManager follows the
         gadget through /sys/class/udc/<udc>/state instead. -->
    <bool name="config_enableUdcSysfsUsbStateUpdate">true</bool>
    <!-- The scroll wheel (OCH1970 Hall sensor, keylayout/och1970-wheel.kl): turns that the app
         in front leaves alone open SystemUI's wheel taskbar -->
    <string-array name="config_scrollWheelInputDevices" translatable="false">
        <item>och1970-wheel</item>
    </string-array>

    <!-- r1-wheeld (wheel/daemon) owns the wheel: its input device and its init socket -->
    <string name="config_wheelDaemonInputDevice" translatable="false">r1-wheel</string>
    <string name="config_wheelDaemonSocket" translatable="false">r1-wheel</string>
    <!-- The wheel is right of the screen, about a fifth of it tall, its bottom on the screen's
         middle: its middle is 40% down -->
    <item name="config_wheelCentre" format="fraction" type="fraction">40%</item>
    <!-- Cromite handles web links by default -->
    <string name="config_defaultBrowser" translatable="false">org.cromite.cromite</string>
    <!-- Apps made for the wheel scroll with it until the user picks otherwise -->
    <string-array name="config_wheelAppModeDefaults" translatable="false">
        <item>cat.kenny.r1.wheel.settings=app</item>
        <item>cat.kenny.r1.performance=app</item>
        <item>cat.kenny.r1.perfoverlay=app</item>
        <item>cat.kenny.r1.batterydetails=app</item>
        <item>cat.kenny.r1.problemreport=app</item>
        <item>cat.kenny.r1.radiosleep=app</item>
        <item>cat.kenny.r1.usbemu=app</item>
        <!-- The easter egg's falling blocks: the wheel's steps are keys the game takes, up
             rotating and down dropping, or moving the piece sideways -->
        <item>com.yet.tetris.release=app</item>
        <item>com.android.settings=app</item>
        <item>org.cromite.cromite=app</item>
        <item>org.lineageos.lineageparts=app</item>
        <!-- The setup wizards: no taskbar before setup is done, the wheel goes through the
             pages and the press is Enter -->
        <item>org.lineageos.setupwizard=app</item>
        <item>com.google.android.setupwizard=app</item>
        <!-- R1HA, made for the R1, takes the wheel's steps as keys itself, as on rabbit's OS -->
        <item>com.github.itskenny0.r1ha=app</item>
        <!-- Pages and dialogs Settings opens in other packages: the wheel goes through them as
             through Settings -->
        <item>com.android.permissioncontroller=app</item>
        <!-- The framework's own dialogs, as "Open with", and the share sheet: lists and
             buttons the wheel goes through, no taskbar over them -->
        <item>android=app</item>
        <item>com.android.intentresolver=app</item>
        <item>com.android.settings.intelligence=app</item>
        <item>com.android.storagemanager=app</item>
        <item>com.android.packageinstaller=app</item>
        <item>com.android.certinstaller=app</item>
        <item>com.android.credentialmanager=app</item>
        <item>com.android.healthconnect.controller=app</item>
        <item>com.android.htmlviewer=app</item>
        <item>com.android.emergency=app</item>
        <item>com.android.cellbroadcastreceiver=app</item>
        <item>com.android.cellbroadcastreceiver.module=app</item>
        <item>com.android.wifi.dialog=app</item>
        <item>com.android.bluetooth=app</item>
        <!-- Pickers and prompts other apps open: the ringtone picker's list and OK, the photo
             picker, VPN, print and device pairing prompts -->
        <item>com.android.soundpicker=app</item>
        <item>com.android.providers.media.module=app</item>
        <item>com.android.vpndialogs=app</item>
        <item>com.android.printspooler=app</item>
        <item>com.android.companiondevicemanager=app</item>
        <item>org.lineageos.updater=app</item>
        <!-- The dialer's quick responses, and the wallpaper and live wallpaper pickers -->
        <item>com.android.server.telecomui=app</item>
        <item>com.android.server.telecom=app</item>
        <item>com.android.wallpaper=app</item>
        <item>com.android.wallpaper.livepicker=app</item>
        <item>org.lineageos.audiofx=app</item>
        <!-- Stock apps that work with the highlight: the wheel moves it through them, the
             side button's double press still brings the taskbar -->
        <item>com.android.dialer=app</item>
        <item>com.android.contacts=app</item>
        <item>org.lineageos.glimpse=app</item>
        <!-- The cameras: the wheel zooms, a press takes the photo -->
        <item>org.lineageos.aperture=camera</item>
        <item>net.sourceforge.opencamera=camera</item>
        <item>com.android.documentsui=app</item>
        <item>org.lineageos.etar=app</item>
        <item>com.android.calculator2=app</item>
        <item>com.android.deskclock=app</item>
        <item>com.android.messaging=app</item>
        <item>org.lineageos.recorder=app</item>
        <item>org.lineageos.twelve=app</item>
        <!-- Installed apps that work with the highlight: Droid-ify, the app store, whose
             toolbar, menus and app rows it goes through, where in taskbar mode every step
             only brought the taskbar -->
        <item>com.looker.droidify=app</item>
        <!-- Home: the wheel goes through the list and its tabs; the side button's double press
             still brings the taskbar -->
        <item>com.android.launcher3=app</item>
    </string-array>

    <bool name="config_r1SideButtonInput">true</bool>

    <!-- A double press of the side button opens the wheel taskbar (MULTI_PRESS_POWER_WHEEL_TASKBAR)
         in any wheel mode, instead of the camera -->
    <integer name="config_doublePressOnPowerBehavior">4</integer>
    <integer name="config_doubleTapPowerGestureMode">0</integer>
    <bool name="config_cameraDoubleTapPowerGestureEnabled">false</bool>
    <!-- Standby too: once the side button stops turning the screen off, the power menu and
         the taskbar do -->
    <string-array translatable="false" name="config_globalActionsList">
        <item>power</item>
        <item>restart</item>
        <item>screenshot</item>
        <item>standby</item>
        <item>lockdown</item>
        <item>emergency</item>
        <item>bugreport</item>
    </string-array>
    <!-- No screen saver until the user turns one on; then, with no dock, it starts while
         charging, its only trigger -->
    <bool name="config_dreamsEnabledByDefault">false</bool>
    <bool name="config_dreamsActivatedOnDockByDefault">false</bool>
    <bool name="config_dreamsActivatedOnSleepByDefault">true</bool>
    <!-- The power + volume-up chord can't be pressed: the R1 has no volume keys -->
    <bool name="config_volumeHushGestureEnabled">false</bool>
</resources>
