<resources>
    <!-- The lock icon's touch area is 72dp across, 82 px at density 186; the
         default 48 px padding is sized for ~420 dpi phones and leaves next to
         nothing of the icon here. 21 px keeps the phones' proportion, an icon
         about half the touch area. -->
    <dimen name="lock_icon_padding">21px</dimen>
    <!-- Power menu buttons for 640 px: 96dp circles (112 px) and 24dp gaps leave no room for
         the stats card and the pinned apps above the home handle. 82dp keeps the icon's
         proportion (padding 38/96). -->
    <dimen name="global_actions_button_size">82dp</dimen>
    <dimen name="global_actions_button_padding">32dp</dimen>
    <dimen name="global_actions_lite_padding">16dp</dimen>
</resources>
