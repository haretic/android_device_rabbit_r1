<resources>
    <!-- The r1 has no volume keys: media volume sits with brightness in quick settings. -->
    <bool name="config_qsMediaVolumeSlider">true</bool>
    <!-- CPU, temperature, battery and RAM graphs with the power menu -->
    <bool name="config_powerMenuStats">true</bool>
    <!-- Wheel moves the focus, the side button presses -->
    <bool name="config_powerMenuWheelNavigation">true</bool>
    <!-- One action a row in portrait, what the wheel walks best on 480x640 -->
    <bool name="config_powerMenuList">true</bool>
    <!-- A last, louder low battery warning shortly before the r1 turns itself off -->
    <integer name="config_lastBatteryWarningLevel">3</integer>
    <!-- The taskbar at the right edge, opened by the wheel -->
    <bool name="config_wheelTaskbar">true</bool>
    <!-- Its last button: its own settings app -->
    <string name="config_wheelTaskbarSettings" translatable="false">cat.kenny.r1.wheel.settings/.WheelActivity</string>
</resources>
