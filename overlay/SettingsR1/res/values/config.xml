<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The panel offers 60 to 100 Hz modes; let the user cap the rate. -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <!-- Low/medium/high vibration intensity sliders; the framework overlay maps
         them onto the motor's 2.0, 2.8 and 3.0 V steps. -->
    <integer name="config_vibration_supported_intensity_levels">3</integer>
    <!-- No dock to start the screen saver: "While charging" is its only trigger -->
    <string-array name="when_to_start_screensaver_entries_no_battery" translatable="false">
        <item>While charging</item>
    </string-array>
    <string-array name="when_to_start_screensaver_values_no_battery" translatable="false">
        <item>while_charging_only</item>
    </string-array>
    <string-array name="when_to_start_screensaver_entries" translatable="false">
        <item>While charging</item>
    </string-array>
    <string-array name="when_to_start_screensaver_values" translatable="false">
        <item>while_charging_only</item>
    </string-array>
    <!-- Low light mode starts from a light sensor, which the R1 doesn't have -->
    <string-array name="low_light_display_behavior_supported_values" translatable="false" />
    <!-- VR helper services serve VR mode, which the R1 can't run -->
    <bool name="config_show_enabled_vr_listeners">false</bool>
    <!-- haret1c, the boot animation, has a sound for its closing part: Sound offers the
         switch for it, off until turned on (persist.sys.bootanim.play_sound in device.mk) -->
    <bool name="has_boot_sounds">true</bool>
    <!-- The wheel emits single volume events, not held keys or chords. -->
    <bool name="config_hasPhysicalVolumeKeys">false</bool>
    <!-- The apps haretic bundles that the R1 doesn't need: App info uninstalls them -->
    <string-array name="config_userRemovableSystemPackages" translatable="false">
        <item>com.aurora.store</item>
        <item>org.cromite.cromite</item>
        <item>com.looker.droidify</item>
        <item>net.sourceforge.opencamera</item>
        <item>com.github.itskenny0.r1ha</item>
        <item>com.yet.tetris.release</item>
    </string-array>
    <!-- Sound has the speaker's gain as a slider over the range that needs no warning; Kernel
         tweaks has the rest of it. The tweaks' script puts it in. -->
    <string name="config_speaker_gain_property" translatable="false">persist.sys.r1.kt.speaker</string>
    <string name="config_speaker_gain_apply_property" translatable="false">sys.r1.kt.apply</string>
    <integer name="config_speaker_gain_min">-6</integer>
    <integer name="config_speaker_gain_max">10</integer>
    <integer name="config_speaker_gain_default">8</integer>
</resources>
