// Settings > Performance overlay: a small FPS / CPU / temperature / battery readout on top
// of games, with a Quick Settings tile. Runs as the system user, which may read
// SurfaceFlinger's frame counter and dumps and draw a system overlay window.
android_app {
    name: "PerfOverlay",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    static_libs: [
        "androidx.preference_preference",
        "SettingsLibPreference",
        "r1-wheelselect",
    ],
    optimize: {
        enabled: false,
    },
}
