<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cat.kenny.r1.perfoverlay"
    android:sharedUserId="android.uid.system">

    <!-- The front app's frame rate, from SurfaceFlinger (TaskFps) -->
    <uses-permission android:name="android.permission.ACCESS_FPS_COUNTER" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_perf_overlay"
        android:label="@string/overlay_title"
        android:supportsRtl="true">

        <!-- Opened from Settings > Performance and by a long press on the tile -->
        <activity
            android:name=".OverlayActivity"
            android:exported="true"
            android:label="@string/overlay_title"
            android:theme="@style/Theme.SubSettingsBase.Expressive">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".HudService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Performance overlay drawn on top of other apps" />
        </service>

        <!-- Off until the overlay is used for the first time, see Hud.showTile() -->
        <service
            android:name=".HudTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_perf_overlay"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- SystemUI keeps the last state and only binds on a click or when the app
                 asks for an update (Hud.apply) -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Puts the overlay back after a restart if it was on. The app switches it off
             while the overlay is off. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Switches the overlay on or off, e.g. from a key shortcut in system_server.
             Only senders holding DEVICE_POWER (the system) may use it. -->
        <receiver
            android:name=".ToggleReceiver"
            android:exported="true"
            android:permission="android.permission.DEVICE_POWER">
            <intent-filter>
                <action android:name="cat.kenny.r1.perfoverlay.action.TOGGLE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
