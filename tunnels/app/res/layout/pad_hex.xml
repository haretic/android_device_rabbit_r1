<!-- A network ID and the keys to type it, 0-9 and a-f: the wheel goes from key to key in
     reading order, a press or a tap types it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/number" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="64dp"
        android:layout_marginBottom="6dp" android:gravity="center"
        android:background="@drawable/card_bg" android:textSize="23sp"
        android:textColor="@color/text" android:letterSpacing="0.04"
        android:fontFamily="monospace" android:maxLines="1" />
    <!-- The keys in rows; on its side the page sets them in fewer, wider rows -->
    <LinearLayout android:id="@+id/keys" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/hex_0" style="@style/Key" android:text="0" />
            <TextView android:id="@+id/hex_1" style="@style/Key" android:text="1" />
            <TextView android:id="@+id/hex_2" style="@style/Key" android:text="2" />
            <TextView android:id="@+id/hex_3" style="@style/Key" android:text="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/hex_4" style="@style/Key" android:text="4" />
            <TextView android:id="@+id/hex_5" style="@style/Key" android:text="5" />
            <TextView android:id="@+id/hex_6" style="@style/Key" android:text="6" />
            <TextView android:id="@+id/hex_7" style="@style/Key" android:text="7" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/hex_8" style="@style/Key" android:text="8" />
            <TextView android:id="@+id/hex_9" style="@style/Key" android:text="9" />
            <TextView android:id="@+id/hex_a" style="@style/Key" android:text="a" />
            <TextView android:id="@+id/hex_b" style="@style/Key" android:text="b" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/hex_c" style="@style/Key" android:text="c" />
            <TextView android:id="@+id/hex_d" style="@style/Key" android:text="d" />
            <TextView android:id="@+id/hex_e" style="@style/Key" android:text="e" />
            <TextView android:id="@+id/hex_f" style="@style/Key" android:text="f" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <FrameLayout android:id="@+id/key_back" style="@style/Key"
                android:background="@drawable/key_quiet_bg"
                android:contentDescription="@string/key_backspace_char">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center" android:src="@drawable/ic_backspace"
                    android:tint="#FFFFFF" android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView android:id="@+id/key_next" style="@style/Key"
                android:background="@drawable/key_go_bg" android:textColor="@color/on_accent"
                android:textSize="15sp" android:fontFamily="haretic-text-bold"
                android:text="@string/next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
