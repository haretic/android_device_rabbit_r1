<!-- Back on the left, the way on on the right, larger -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
    <TextView android:id="@+id/back" style="@style/Button.Quiet" android:layout_weight="1"
        android:layout_marginEnd="8dp" android:text="@string/back" />
    <TextView android:id="@+id/go" style="@style/Button" android:layout_weight="1.6" />
</LinearLayout>
