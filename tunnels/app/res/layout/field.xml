<!-- A text field with its name over it; the system's keyboard types into it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/label" style="@style/FieldLabel" />
    <EditText android:id="@+id/edit" style="@style/Field" />
</LinearLayout>
