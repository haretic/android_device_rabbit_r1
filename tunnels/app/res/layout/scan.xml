<!-- The camera's picture with the corners to hold the code in -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame" android:layout_width="match_parent" android:layout_height="380dp"
    android:layout_marginBottom="8dp" android:background="@drawable/card_bg"
    android:clipToOutline="true">
    <TextureView android:id="@+id/preview" android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <cat.kenny.r1.tunnels.CornersView android:id="@+id/corners"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
