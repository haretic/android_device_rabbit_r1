<!-- The pad's Next: faded until the number is whole -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="?android:attr/colorAccent" /><corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" /></shape>
    </item>
    <item><shape><solid android:color="?android:attr/colorAccent" /><corners android:radius="14dp" /></shape></item>
</selector>
