<!-- A choice: the one the wheel is on is tinted, under the wheel's ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#26201D" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#2C2C2C" /><corners android:radius="6dp" /></shape>
    </item>
    <item><shape><solid android:color="@color/row" /><corners android:radius="6dp" /></shape></item>
</selector>
