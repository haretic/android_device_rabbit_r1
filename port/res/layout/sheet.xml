<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/outside" android:layout_width="match_parent"
    android:focusable="false"
    android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="@drawable/sheet_bg" android:clickable="true"
        android:focusable="false"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="18dp"
        android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:paddingStart="6dp"
            android:paddingBottom="12dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp"
                android:src="@drawable/ic_usb" android:tint="?android:attr/colorAccent"
                android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="14dp">
                <TextView android:id="@+id/head" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="19sp"
                    android:textStyle="bold" android:textColor="@color/text"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/sum" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="15sp"
                    android:textColor="@color/text_sum" android:maxLines="1"
                    android:ellipsize="end" android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/copy_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            android:textSize="14sp" android:textColor="@color/text_sum"
            android:visibility="gone" />
        <!-- Weighted, so that on a short screen it scrolls and the hint under it stays -->
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:id="@+id/rows" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
        <LinearLayout android:id="@+id/hint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingTop="10dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_lock" android:tint="?android:attr/colorAccent"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/hint_text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:textSize="14sp" android:textColor="@color/text_sum" />
        </LinearLayout>
        <!-- What the wheel and the button do on the sheet -->
        <TextView android:id="@+id/guide" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingStart="8dp"
            android:paddingTop="8dp" android:textSize="13sp"
            android:textColor="@color/text_sum" android:text="@string/sheet_guide" />
    </LinearLayout>
</FrameLayout>
