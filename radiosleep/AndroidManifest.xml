<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cat.kenny.r1.radiosleep">
    <uses-permission android:name="android.permission.NETWORK_AIRPLANE_MODE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Persistent: screen on/off broadcasts only reach registered receivers. -->
    <application android:name=".RadioSleep" android:persistent="true"
        android:label="@string/app_name" android:allowBackup="false"
        android:directBootAware="true" android:supportsRtl="true">
        <receiver android:name=".SleepReceiver" android:exported="false"
            android:directBootAware="true" />
        <activity android:name=".RadioSleepActivity" android:exported="true"
            android:permission="android.permission.DEVICE_POWER"
            android:theme="@style/Theme.SubSettingsBase.Expressive">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/app_name" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/tile_summary" />
            <meta-data android:name="com.android.settings.keyhint" android:value="r1_radio_sleep" />
            <meta-data android:name="com.android.settings.profile" android:value="primary_profile_only" />
        </activity>
        <!-- The same page in Network & internet, where people look for Wi‑Fi in sleep -->
        <activity-alias android:name=".RadioSleepNetwork" android:exported="true"
            android:targetActivity=".RadioSleepActivity"
            android:permission="android.permission.DEVICE_POWER">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.wireless" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/app_name" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/tile_summary" />
            <meta-data android:name="com.android.settings.keyhint" android:value="r1_radio_sleep_network" />
            <meta-data android:name="com.android.settings.profile" android:value="primary_profile_only" />
        </activity-alias>
        <provider android:name=".SearchProvider"
            android:authorities="cat.kenny.r1.radiosleep.search"
            android:multiprocess="false"
            android:grantUriPermissions="true"
            android:permission="android.permission.READ_SEARCH_INDEXABLES"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.action.SEARCH_INDEXABLES_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
