# rootdir/r1-cromite-switches.sh: writes Cromite's switches to /data/local/tmp, where init
# may not add files.
type r1_cromite_switches, domain, coredomain;
type r1_cromite_switches_exec, exec_type, file_type, system_file_type;
init_daemon_domain(r1_cromite_switches)

allow r1_cromite_switches { shell_exec toolbox_exec }:file rx_file_perms;
allow r1_cromite_switches shell_data_file:dir rw_dir_perms;
allow r1_cromite_switches shell_data_file:file create_file_perms;
