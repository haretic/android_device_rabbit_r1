# SPDX-License-Identifier: Apache-2.0
# Cromite opens without its first-run screens: Chromium reads its switches from
# /data/local/tmp/chrome-command-line on userdebug builds, the first word standing for the
# program. init may not add files there, so a shell-user service writes it
service r1-cromite-switches /system_ext/bin/r1-cromite-switches.sh
    user shell
    group shell
    oneshot
    disabled

on property:sys.boot_completed=1
    start r1-cromite-switches
