# r1-wheel-touch: r1-wheeld's finger for the wheel's scroll mode, a touchscreen as big as the
# real one that drags in the middle of the display. Its axes are the screen's as it is turned,
# so a drag up and down the middle stays up and down in landscape, and the touch zones'
# thousandths are of the screen as seen.
device.internal = 1
touch.deviceType = touchScreen
touch.orientationAware = 0
