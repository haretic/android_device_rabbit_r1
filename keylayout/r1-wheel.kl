# r1-wheel, the scroll wheel as r1-wheeld (wheel/daemon) sends it on, one pair per mode:
# taskbar (NAVIGATE_*: the policy gives them to SystemUI's wheel taskbar while an app is in
# front, r1-wheel.kcm makes them D-pad steps in system windows), app and volume.

key 103   DPAD_UP
key 108   DPAD_DOWN
key 114   VOLUME_DOWN
key 115   VOLUME_UP
key 177   NAVIGATE_PREVIOUS
key 178   NAVIGATE_NEXT
