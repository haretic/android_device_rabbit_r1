<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cat.kenny.r1.wheel.settings"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="lineageos.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_wheel"
        android:label="@string/wheel_title"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <!-- Settings > System > Scroll wheel -->
        <activity
            android:name=".WheelActivity"
            android:exported="true"
            android:label="@string/wheel_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="r1_wheel" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/wheel_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/wheel_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_wheel" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>

        <!-- The first-run tour of the wheel and the side button; home opens it once -->
        <activity
            android:name=".TourActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="nosensor"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="cat.kenny.r1.wheel.action.TOUR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- An app's touch zones, over the app; the taskbar's Wheel mode menu opens it too -->
        <activity
            android:name=".TouchZonesActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.TouchZones" />
    </application>
</manifest>
