    <!-- Help: short notes, with links to the settings they describe -->
    <string name="help_title">How the wheel works</string>
    <string name="help_summary">What each control does, and a page to try them</string>
    <string name="help_turn_title">Turn - move the highlight</string>
    <string name="help_turn_summary">Moves the highlight ring to the next item; a list scrolls along. Change the wheel\'s feel and direction here.</string>
    <string name="help_press_title">Press - pick</string>
    <string name="help_press_summary">Picks the item in the ring, as a tap would. Change the side button here.</string>
    <string name="help_hold_title">Hold - go back</string>
    <string name="help_hold_summary">Goes back a screen. In the taskbar, a hold on an item opens its options instead. Change it here.</string>
    <string name="help_double_press_title">Double press - taskbar</string>
    <string name="help_double_press_summary">Open the taskbar from any app. Change its edge and timing here.</string>
    <string name="help_grab_title">Grab - turn - let go</string>
    <string name="help_grab_summary">Sliders and time pickers: press to grab, turn to set, press again or wait to let go. Lists of choices in Settings work the same; press without turning to see them all.</string>
    <string name="help_sleep_title">Turn the screen off</string>
    <string name="help_sleep_summary">Double-tap the status bar at the top. The side button wakes it. Three presses can turn it off too: set that here.</string>
    <string name="help_back_summary">In the taskbar, Back goes back a screen. Show, hide or reorder the bar\'s buttons here.</string>
    <string name="help_buttons_title">More taskbar buttons</string>
    <string name="help_buttons_summary">Home - home screen\nAll apps - app list\nPinned and running apps - switch apps\nNotifications - alerts\nChange buttons and order here.</string>
    <string name="help_mode_summary">Some apps use the wheel their own way: to scroll, zoom, set the volume or skip tracks. In the taskbar, Wheel mode sets it for the app in front. Change each app here.</string>
    <string name="help_power_summary">In the taskbar, press Power for the power menu, hold for its options in the bar. Change this here.</string>
    <string name="help_pin_title">Lock screen - dial and 123</string>
    <string name="help_pin_summary">Turn the dial with the wheel to enter your PIN, or tap 123 for number keys. Change the PIN control here.</string>
    <string name="help_tour_summary">Run the step-by-step tour again</string>

