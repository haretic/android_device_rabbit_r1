    <string name="tour_well_done">That\'s it</string>
    <string name="tour_welcome_title">Made for the wheel</string>
    <string name="tour_welcome_body">Each step shows one control. Try it and the tour moves on.\n*Touch always works too*: tap Next to go on.\nTo leave, turn up to *Skip* and press, or tap it. The tour stays in Settings.</string>
    <string name="tour_welcome_hint">Press the side button to start</string>
    <string name="tour_turn_title">Turn to move</string>
    <string name="tour_turn_body">*Turn the wheel* to move the highlight from one item to the next.\nLists scroll along with it.</string>
    <string name="tour_turn_hint">Turn the wheel a few steps</string>
    <string name="tour_press_title">Press to pick</string>
    <string name="tour_press_body">*Press the side button* to pick the highlighted item, as a tap would.</string>
    <string name="tour_press_hint">Pick a row with the side button</string>
    <string name="tour_hold_title">Hold to go back</string>
    <string name="tour_hold_body">*Hold the side button* to go back, in any app.\nIn the taskbar, a hold on an item opens its options instead, like a long press.</string>
    <string name="tour_hold_hint">Hold the side button</string>
    <string name="tour_hold_again">Keep it held a little longer</string>
    <string name="tour_taskbar_title">Press twice for the taskbar</string>
    <string name="tour_taskbar_body">*Double press the side button* to open the taskbar from any app.\nIt has Back, Home, All apps and more.\n*Double press again* to close it.</string>
    <string name="tour_taskbar_hint">Double press to open the taskbar</string>
    <string name="tour_slider_title">Grab a slider</string>
    <string name="tour_slider_body">*Press* to grab this slider.\n*Turn* to change it.\n*Press* again to let go.\nTime and date pickers work the same way.</string>
    <string name="tour_slider_hint">Press to grab</string>
    <string name="tour_slider_turn">Turn to change it</string>
    <string name="tour_slider_release">Press to let go</string>
    <string name="tour_back_title">Back in the taskbar</string>
    <string name="tour_back_body">*Double press* to open the taskbar.\n*Turn* to Back and *press* it to return here.</string>
    <string name="tour_back_hint">Double press, then pick Back</string>
    <string name="tour_power_title">Power options on a hold</string>
    <string name="tour_power_body">In the taskbar, *press Power* for the power menu.\n*Hold* the side button on Power for its options right in the bar.</string>
    <string name="tour_power_hint">Press to continue</string>
    <string name="tour_sleep_title">Turn the screen off</string>
    <string name="tour_sleep_body">The side button wakes the screen.\nTo turn it off, *double-tap the status bar*, the strip with the time at the top.\nTry it, then press the side button to wake the screen.</string>
    <string name="tour_sleep_hint">Double-tap the top, or press to go on</string>
    <string name="tour_help_title">Help is always here</string>
    <string name="tour_help_body">*How the wheel works* in Settings - System - Taskbar and Wheel explains every control, with a *Try it* page to practise on.\nOpen it now, then come back.</string>
    <string name="tour_help_hint">Press to open help</string>
    <string name="tour_help_open">Open help</string>
    <string name="tour_done_title">You\'re set</string>
    <string name="tour_done_body">Change what the side button does, or switch the wheel UI off for the stock look, in Settings - System - Taskbar and Wheel. The tour is there too.</string>
    <string name="tour_done_hint">Press to finish</string>
    <string name="tour_row_1">Turn the wheel</string>
    <string name="tour_row_2">to move this highlight</string>
    <string name="tour_row_3">up and down</string>

