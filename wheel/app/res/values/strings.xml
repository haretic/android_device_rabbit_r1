    <string name="part_lockscreen_title">Lock screen</string>
    <string name="part_lockscreen_summary">An Unlock button the side button presses, the PIN picked with the wheel. Off: the original lock screen</string>
    <string name="part_dialogs_title">Dialogs</string>
