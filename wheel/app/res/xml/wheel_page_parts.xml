<!-- Each revised part of the system or its original, a page of Taskbar and wheel; WheelFragment binds every LineageSettings.Secure key in it. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No heading: it would only repeat the page's title. The columns first, a list, so the
         wheel's first stop is not a switch a stray press would flip -->
    <PreferenceCategory android:key="parts">
        <ListPreference
            android:key="wheel_button_columns"
            android:title="@string/button_columns_title"
            android:entries="@array/button_columns_entries"
            android:entryValues="@array/button_columns_values"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_shade"
            android:title="@string/part_shade_title"
            android:summary="@string/part_shade_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_lockscreen"
            android:title="@string/part_lockscreen_title"
            android:summary="@string/part_lockscreen_summary"
            android:persistent="false" />
        <ListPreference
            android:key="wheel_unlock"
            android:dependency="wheel_lockscreen"
            android:title="@string/unlock_title"
            android:entries="@array/unlock_entries"
            android:entryValues="@array/unlock_values"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_dialogs"
            android:title="@string/part_dialogs_title"
            android:summary="@string/part_dialogs_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_home"
            android:title="@string/part_home_title"
            android:summary="@string/part_home_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_settings"
            android:title="@string/part_settings_title"
            android:summary="@string/part_settings_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_styles"
            android:title="@string/part_styles_title"
            android:summary="@string/part_styles_summary"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
