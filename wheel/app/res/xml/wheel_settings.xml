<!-- Taskbar and wheel, from the taskbar's last button and Settings > System: the switch, the
     tour, and a page each for the side button, the taskbar, the wheel's feel, the apps and the
     system's parts (wheel_page_*.xml, WheelFragment). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/wheel_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="wheel_ui"
        android:title="@string/wheel_ui"
        android:persistent="false" />

    <!-- How it works, the tour home opens the first time -->
    <Preference
        android:key="tour"
        android:title="@string/tour_title"
        android:summary="@string/tour_summary">
        <intent
            android:targetPackage="cat.kenny.r1.wheel.settings"
            android:targetClass="cat.kenny.r1.wheel.settings.TourActivity" />
    </Preference>

    <PreferenceCategory
        android:key="pages"
        android:title="@string/cat_customise">
        <Preference
            android:key="page_side_button"
            android:title="@string/page_side_button_title"
            android:summary="@string/page_side_button_summary"
            android:fragment="cat.kenny.r1.wheel.settings.WheelFragment">
            <extra android:name="page" android:value="side_button" />
        </Preference>
        <Preference
            android:key="page_taskbar"
            android:title="@string/page_taskbar_title"
            android:summary="@string/page_taskbar_summary"
            android:fragment="cat.kenny.r1.wheel.settings.WheelFragment">
            <extra android:name="page" android:value="taskbar" />
        </Preference>
        <Preference
            android:key="app_modes"
            android:title="@string/app_modes_title"
            android:fragment="cat.kenny.r1.wheel.settings.AppModesFragment" />
        <Preference
            android:key="page_feel"
            android:title="@string/page_feel_title"
            android:summary="@string/page_feel_summary"
            android:fragment="cat.kenny.r1.wheel.settings.WheelFragment">
            <extra android:name="page" android:value="feel" />
        </Preference>
        <Preference
            android:key="page_parts"
            android:title="@string/page_parts_title"
            android:summary="@string/page_parts_summary"
            android:fragment="cat.kenny.r1.wheel.settings.WheelFragment">
            <extra android:name="page" android:value="parts" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
