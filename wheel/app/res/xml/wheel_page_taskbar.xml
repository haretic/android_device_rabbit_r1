<!-- The taskbar, a page of Taskbar and wheel; WheelFragment binds every LineageSettings.Secure key in it. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="bar"
        android:title="@string/cat_bar">
        <Preference
            android:key="buttons"
            android:title="@string/buttons_title"
            android:fragment="cat.kenny.r1.wheel.settings.ButtonsFragment" />
        <ListPreference
            android:key="wheel_taskbar_running"
            android:title="@string/running_title"
            android:entries="@array/running_entries"
            android:entryValues="@array/running_values"
            android:persistent="false" />
        <ListPreference
            android:key="wheel_taskbar_edge"
            android:title="@string/edge_title"
            android:entries="@array/edge_entries"
            android:entryValues="@array/edge_values"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_taskbar_push"
            android:title="@string/push_title"
            android:summary="@string/push_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="behaviour"
        android:title="@string/cat_behaviour">
        <ListPreference
            android:key="wheel_taskbar_list_end"
            android:title="@string/list_end_title"
            android:entries="@array/list_end_entries"
            android:entryValues="@array/list_end_values"
            android:persistent="false" />
        <ListPreference
            android:key="wheel_taskbar_timeout"
            android:title="@string/timeout_title"
            android:entries="@array/timeout_entries"
            android:entryValues="@array/timeout_values"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_taskbar_labels"
            android:title="@string/labels_title"
            android:summary="@string/labels_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_taskbar_haptics"
            android:title="@string/haptics_title"
            android:summary="@string/haptics_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="wheel_taskbar_sounds"
            android:title="@string/sounds_title"
            android:summary="@string/sounds_summary"
            android:persistent="false" />
        <ListPreference
            android:key="wheel_taskbar_animations"
            android:title="@string/animations_title"
            android:entries="@array/animations_entries"
            android:entryValues="@array/animations_values"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
