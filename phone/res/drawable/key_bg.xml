<!-- A control on the music card: the one the wheel is on is tinted, under the wheel's ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#3A2A22" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#3A322D" /><corners android:radius="14dp" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /><corners android:radius="14dp" /></shape></item>
</selector>
