<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="16dp">
        <TextView style="@style/Title" android:text="@string/settings_title" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="24dp" android:layout_marginEnd="18dp"
            android:layout_marginBottom="10dp" android:textSize="14sp"
            android:textColor="@color/text_dim" android:text="@string/settings_guide" />
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginStart="18dp" android:layout_marginEnd="18dp" />
    </LinearLayout>
</ScrollView>
