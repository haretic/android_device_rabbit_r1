# Kernel Tweaks (the Performance app's page): counts starts, applies the choices once Android
# is up and after every change (sys.r1.kt.apply), see r1-ktweaks.sh.
on post-fs-data
    exec_background - root root -- /system_ext/bin/r1-ktweaks.sh start

on property:sys.boot_completed=1
    start r1-ktweaks
    start r1-ktweaks-settle

on property:sys.r1.kt.apply=*
    start r1-ktweaks

# The power HAL sets the GPU's top speed with its hints (extreme saver), the cap goes back on after
on property:sys.powerhal.held_hints=*
    start r1-ktweaks-gpu

# The audio HAL sets the card's gains up again when it starts
on property:init.svc.vendor.audio-hal-aidl-mainline=running && property:sys.boot_completed=1
    start r1-ktweaks-audio

service r1-ktweaks-audio /system_ext/bin/r1-ktweaks.sh audio
    user root
    group root audio
    disabled
    oneshot

service r1-ktweaks-gpu /system_ext/bin/r1-ktweaks.sh gpu
    user root
    group root
    disabled
    oneshot

service r1-ktweaks /system_ext/bin/r1-ktweaks.sh apply
    user root
    # audio for the speaker and mic gains
    group root audio
    disabled
    oneshot

# The overclock stress test, from the CPU overclock page. In the system group for the speed
# limits, which the power HAL's init hands to system (0664).
on property:sys.r1.kt.octest=*
    start r1-ktweaks-octest

service r1-ktweaks-octest /system_ext/bin/r1-ktweaks.sh octest
    user root
    group root system
    disabled
    oneshot

# Two minutes up after the tweaks went in counts as a good start
service r1-ktweaks-settle /system_ext/bin/r1-ktweaks.sh settle
    user root
    group root
    disabled
    oneshot
    priority 10
