<!-- Web desk and the walkie-talkie are nothing but the local network: opening them is the
     asking. The walkie-talkie's microphone is still asked for. -->
<exceptions>
    <exception package="cat.kenny.r1.webdesk">
        <permission name="android.permission.ACCESS_LOCAL_NETWORK" fixed="false" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
    <exception package="cat.kenny.r1.walkie">
        <permission name="android.permission.ACCESS_LOCAL_NETWORK" fixed="false" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
    <!-- Private networks: a tunnel whose server is on the local network; setting one up is
         the asking -->
    <exception package="cat.kenny.r1.tunnels">
        <permission name="android.permission.ACCESS_LOCAL_NETWORK" fixed="false" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
    <!-- The port's lock screen card and its note of what a computer may reach -->
    <exception package="cat.kenny.r1.port">
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
    <!-- The knob is nothing but Bluetooth: opening it is the asking -->
    <exception package="cat.kenny.r1.knob">
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false" />
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false" />
    </exception>
    <!-- The phone link is nothing but Bluetooth: turning it on is the asking -->
    <exception package="cat.kenny.r1.phone">
        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="false" />
        <permission name="android.permission.BLUETOOTH_SCAN" fixed="false" />
        <permission name="android.permission.BLUETOOTH_ADVERTISE" fixed="false" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
    </exception>
</exceptions>
