cc_binary {
    name: "r1-bt-bdaddr",
    srcs: ["bt_bdaddr.cpp"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libcrypto",
        "liblog",
    ],
    // Runs device/mainline/common's bdaddr, in PRODUCT_PACKAGES.
    init_rc: ["r1-bt-bdaddr.rc"],
}
